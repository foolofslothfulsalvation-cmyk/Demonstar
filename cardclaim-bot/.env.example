# Demonstar environment variables
# Copy this file to .env and fill in your values
# These override config.json settings

# Your WhatsApp number (international format, digits only, no leading 0 or +)
CC_PHONE=2349153327424

# Config file path (default: config.json)
CC_CONFIG=config.json

# Start in dry run mode? (on/off) — log only, no claims sent
CC_DRY_RUN=on

# Start paused? (on/off)
CC_PAUSED=off

# Log level: trace, debug, info, warn, error, fatal, silent
CC_LOG_LEVEL=info

# Claiming profile: conservative, balanced, aggressive, stealth
CC_PROFILE=balanced

# Tier attempt chances (0-100 percent)
CC_TIER_1=0
CC_TIER_2=25
CC_TIER_3=75
CC_TIER_4=100
CC_TIER_5=100
CC_TIER_6=100

# Global rate limits
CC_MAX_MINUTE=6
CC_MAX_HOUR=20
CC_MAX_DAY=80
CC_MIN_GAP=2500
CC_MAX_PER_BATCH=1
CC_LOW_TIER_DELAY=12000

# Session settings
CC_HEALTH_CHECK_MS=300000
CC_SESSION_WARN_DAYS=13
CC_AUTO_REPAIR=true
CC_WATCHDOG=true

# Notifications
CC_NOTIFY_HIGH_TIER=true
CC_NOTIFY_SUMMARY=false

# Game bot toggles
CC_BOT_JOKER=on
CC_BOT_SUBARU=on
CC_BOT_JAKE=on

# Extra DM control numbers (comma-separated, digits only)
CC_CONTROL_NUMBERS=

# Blocked group JIDs (comma-separated)
CC_BLOCK_GROUPS=
